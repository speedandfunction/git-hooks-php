#!/bin/bash

# PHP Syntax Check Pre-commit Hook
# This hook checks all staged PHP files for syntax errors before allowing a commit

echo "Checking PHP syntax..."

# Get all staged PHP files
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$STAGED_PHP_FILES" ]; then
    echo "No PHP files to check."
    exit 0
fi

SYNTAX_ERROR=0

# Check each PHP file for syntax errors
for FILE in $STAGED_PHP_FILES; do
    php -l "$FILE" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ Syntax error in: $FILE"
        php -l "$FILE"
        SYNTAX_ERROR=1
    else
        echo "✓ $FILE"
    fi
done

if [ $SYNTAX_ERROR -eq 1 ]; then
    echo ""
    echo "❌ Commit aborted: Fix PHP syntax errors before committing."
    exit 1
fi

echo "✅ All PHP files passed syntax check."
exit 0
